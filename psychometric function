install.packages("quickpsy")\
install.packages("patchwork")\
library(quickpsy)\
library(tidyverse)\
library(patchwork)\
\
# quickpsy needs averaged data per band per participant\
# Summarise to mean proportion correct per band/proc/condition\
psy_data <- model_data %>%\
mutate(proc_label = ifelse(proc == "NV", "Noise Vocoded", "Locally Rotated")) %>%\
group_by(bands_num, proc_label, condition) %>%\
summarise(\
n_correct = sum(n_correct, na.rm = TRUE),\
n_total = sum(n_total, na.rm = TRUE),\
.groups = "drop"\
)\
\
original_bands <- sort(unique(as.integer(str_remove(model_data$bands, "b"))))\
log_bands <- log(original_bands)\
\
psy_data <- psy_data %>%\
mutate(bands_num = as.numeric(log(bands_num)))\
\
# Fit psychometric functions with free lapse rate\
fit <- quickpsy(\
psy_data,\
x = bands_num, # predictor\
k = n_correct, # number correct\
n = n_total, # number total\
grouping = .(proc_label, condition), # fit separately per group\
fun = cum_normal_fun, # probit = cumulative normal\
B = 100, # bootstrap samples for CIs\
lapses = TRUE, # THIS is what allows asymptote < 100%\
guess = FALSE # no guessing rate (not a forced choice task)\
)\
\
# Predicted curves\
pred_curves <- fit$curves\
\
# Thresholds (50% point)\
thresholds <- fit$thresholds\
print(thresholds)\
\
# Lapse rates\
lapses <- fit$par %>% filter(parn == "lambda")\
print(lapses)\
\
# Custom plot\
make_plot <- function(cond_label, proc_label_filter) {\
\
colour_val <- ifelse(proc_label_filter == "Noise Vocoded", "#E66100", "#5D3A9B")\
\
pred <- pred_curves %>% filter(condition == cond_label, proc_label == proc_label_filter)\
obs <- psy_data %>%\
filter(condition == cond_label, proc_label == proc_label_filter) %>%\
mutate(mean_pct = n_correct / n_total * 100)\
thresh <- thresholds %>% filter(condition == cond_label, proc_label == proc_label_filter)\
\
ggplot() +\
geom_line(data = pred,\
aes(x = x, y = y * 100),\
colour = colour_val, linewidth = 0.5) +\
geom_point(data = obs,\
aes(x = bands_num, y = mean_pct),\
colour = colour_val, alpha = 0.7) +\
geom_vline(data = thresh,\
aes(xintercept = thre),\
colour = colour_val, linetype = "dotted") +\
annotate("text", x = thresh$thre, y = 5,\
label = paste0("50% at ", round(exp(thresh$thre), 1), " bands"),\
hjust = -0.01, size = 3.5, colour = colour_val) +\
scale_y_continuous(limits = c(0, 100), breaks = seq(0, 100, 20)) +\
